{
  "name": "@finopsbricks/fob-snap",
  "version": "0.1.0",
  "description": "Snapshots app client + fob-snap CLI (2-in-1). Import the client in workers, or use the CLI to push snapshots and manage widgets/dashboards.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fob-snap": "./bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "typecheck": "tsc -p jsconfig.json"
  },
  "keywords": [
    "snapshots",
    "dashboards",
    "push-metrics",
    "api-client",
    "cli",
    "finops",
    "finopsbricks"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finopsbricks/fob-snap.git"
  },
  "homepage": "https://github.com/finopsbricks/fob-snap#readme",
  "bugs": "https://github.com/finopsbricks/fob-snap/issues",
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^15.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^22.20.1",
    "jest": "^29.7.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
